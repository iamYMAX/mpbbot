{
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN"
  },
  "GigaChat": {
    "ClientId": "YOUR_GIGACHAT_CLIENT_ID",
    "ClientSecret": "YOUR_GIGACHAT_CLIENT_SECRET",
    "Scope": "GIGACHAT_API_PERS"
  },
  "YandexSpeechKit": {
    "ApiKey": "YOUR_YANDEX_CLOUD_API_KEY",
    "FolderId": "YOUR_YANDEX_CLOUD_FOLDER_ID"
  },
  "Security": {
    "DataProtectionKey": "YOUR_SUPER_SECRET_ENCRYPTION_KEY_32_BYTES"
  },
  "EmailProviderSettings": {
    "RedirectUri": "http://localhost:8085/oauth/callback",
    "Providers": [
      {
        "Provider": "gmail",
        "ImapHost": "imap.gmail.com",
        "ImapPort": 993,
        "ImapUseSsl": true,
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": 587,
        "SmtpUseSsl": true,
        "ClientId": "YOUR_GMAIL_CLIENT_ID.apps.googleusercontent.com",
        "ClientSecret": "YOUR_GMAIL_CLIENT_SECRET",
        "TokenEndpoint": "https://oauth2.googleapis.com/token",
        "AuthEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "Scope": "https://mail.google.com/"
      },
      {
        "Provider": "yandex",
        "ImapHost": "imap.yandex.ru",
        "ImapPort": 993,
        "ImapUseSsl": true,
        "SmtpHost": "smtp.yandex.ru",
        "SmtpPort": 465,
        "SmtpUseSsl": true
      }
    ],
    "GenericImap": {
      "ImapHost": "",
      "ImapPort": 993,
      "ImapUseSsl": true,
      "SmtpHost": "",
      "SmtpPort": 465,
      "SmtpUseSsl": true
    }
  }
}
